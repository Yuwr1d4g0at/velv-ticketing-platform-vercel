# Copy this file to .env and fill in real values before running the app.

# Port the server listens on
PORT=3000

# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string

# Postgres connection string (Neon, via the Vercel Marketplace). Set
# automatically in Vercel's own environment once you run `vercel install neon`
# in this project; for local dev, pull it down with `vercel env pull .env`
# (recommended, keeps it in sync) or copy it by hand from the Vercel
# dashboard's Storage tab. Run `npm run migrate` once against it before
# starting the app for the first time.
DATABASE_URL=

# Read/write token for the Vercel Blob store attachments are uploaded to
# (see src/attachments.js, Phase 3). Set automatically once you run
# `vercel blob create-store` and link it to this project; same
# `vercel env pull` note as DATABASE_URL above applies.
BLOB_READ_WRITE_TOKEN=

# Shared secret Vercel Cron sends back as `Authorization: Bearer <value>`
# when it hits /api/cron/periodic-checks (see vercel.json, Phase 5) - the
# route rejects any request whose header doesn't match this, so the daily
# background-job trigger can't be fired by a random public request. Vercel
# sets this automatically for cron invocations once the env var exists;
# generate one yourself with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Optional: error tracking (https://sentry.io or any Sentry-compatible
# ingest endpoint). Leave blank to keep this off entirely - unhandled
# errors then only show up in Vercel's own function logs, exactly like
# before. Get a DSN by creating a Node project in Sentry.
SENTRY_DSN=

# Set to "true" in the deployed Vercel environment, where TLS is always
# terminated automatically, so session cookies are marked Secure. Keep
# "false" only for local http://localhost development.
COOKIE_SECURE=false

# Optional: email notifications to requesters (ticket received, status
# changes). Leave SMTP_HOST blank to keep email notifications off entirely -
# the app works fine without any of this set.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Velv Ticketing <no-reply@example.com>"

# Optional: public URL of this app (no trailing slash), used to build a
# clickable status-check link in notification emails. Without it, emails just
# name the status page instead of linking to it. Also used to build the
# Microsoft sign-in redirect URL below - has to be set (and correct) for
# MS_* SSO to work, not just for the emails.
APP_URL=

# Optional: "Sign in with Microsoft" (Entra ID / Azure AD) for agent login,
# on top of the existing username+password login (kept as a fallback either
# way). Leave MS_CLIENT_ID blank to keep this off entirely - agents just see
# the plain password form, exactly as before. Requires an app registration
# in Entra ID (Azure Portal / entra.microsoft.com > App registrations) -
# see the "Microsoft 365 SSO" section in README.md for the exact steps.
# Signing in with Microsoft only ever logs someone in if their email already
# matches an existing, active agent (added the normal way, from the Agents
# page or `npm run seed`) - it never creates a new agent by itself.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Optional: how many timestamped backups (see `npm run backup`, written to
# the same Blob store as attachments under backups/) to keep before pruning
# the oldest. Defaults to 14.
BACKUP_KEEP=14

# Optional: how often (in minutes) the server checks for tickets that have
# crossed their aging threshold and emails whoever they're assigned to.
# Defaults to 15. Only matters if SMTP_HOST is set above.
SLA_CHECK_INTERVAL_MINUTES=15

# Optional: how many days before an asset's warranty expiry to start
# emailing the whole active team a heads-up. Defaults to 30. Checked on the
# same interval as SLA_CHECK_INTERVAL_MINUTES above.
WARRANTY_ALERT_DAYS=30

# Optional: which local hour (0-23, server's own timezone - see TZ below)
# to send each agent's daily digest email at. Defaults to 8 (8am). Only
# matters if SMTP_HOST is set above - only fires on whichever periodic
# check (SLA_CHECK_INTERVAL_MINUTES) happens to land in that hour, and at
# most once per agent per calendar day either way.
DIGEST_HOUR=8

# Optional: the "local timezone" that DIGEST_HOUR above and the aging/SLA
# business-hours window (09:00-18:00, src/aging.js) actually run in.
# Defaults to Europe/Lisbon (src/app.js) - a Vercel Function has no
# timezone of its own and defaults to UTC otherwise, which would silently
# turn "9am-6pm local" into "9am-6pm UTC". Only needs setting here if this
# is deployed somewhere other than Portugal - any IANA timezone name works
# (e.g. "America/New_York").
TZ=

# Optional: how many hours between automatic asset-inventory syncs from
# SharePoint (see src/assetSync.js and /dashboard/settings/asset-sync).
# Defaults to 24. Only matters if MS_TENANT_ID/MS_CLIENT_ID/MS_CLIENT_SECRET
# are set AND the app registration has been granted the Sites.Read.All
# Application permission with admin consent - see README.
ASSET_SYNC_INTERVAL_HOURS=24
