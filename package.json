{
  "name": "velv-ticketing-platform",
  "version": "1.0.0",
  "description": "Basic internal helpdesk ticketing platform: public request form + staff dashboard.",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/db/seed.js",
    "migrate": "node scripts/migrate.js",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "test": "node --test --test-concurrency=1"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "@sentry/node": "^10.75.0",
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^2.4.3",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.18.0",
    "helmet": "^7.1.0",
    "multer": "^2.3.0",
    "nodemailer": "^9.1.1",
    "openid-client": "^5.7.1"
  },
  "overrides": {
    "qs": "^6.16.0",
    "body-parser": "^1.20.6"
