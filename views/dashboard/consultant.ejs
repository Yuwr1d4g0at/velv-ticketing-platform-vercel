<%- include('../partials/header') %>
<div class="ticket-head">
  <div>
    <h1><%= consultant.name %></h1>
    <p class="muted"><%= consultant.department_name %><% if (consultant.company) { %> &middot; <%= consultant.company %><% } %><% if (consultant.specialty) { %> &middot; <%= consultant.specialty %><% } %></p>
  </div>
  <div class="badge-group">
    <% if (consultant.confidential) { %><span class="badge badge-aging">Confidential</span><% } %>
    <span class="badge badge-consultant-status-<%= consultant.status.replace(/\s+/g, '-').toLowerCase() %>"><%= consultant.status %></span>
  </div>
</div>

<div class="ticket-grid">
  <div class="ticket-main">
    <div class="card">
      <h2>Details</h2>
      <% if (error) { %>
        <div class="alert alert-error" role="alert"><span class="icon icon-alert-triangle"></span><%= error %></div>
      <% } %>
      <form action="/dashboard/consultants/<%= consultant.id %>" method="POST" class="stacked-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <label for="name">Name</label>
        <input type="text" id="name" name="name" required maxlength="200" value="<%= consultant.name %>">

        <div class="form-row">
          <div>
            <label for="company">Company</label>
            <input type="text" id="company" name="company" maxlength="200" value="<%= consultant.company || '' %>" placeholder="Leave blank if freelance">
          </div>
          <div>
            <label for="specialty">Specialty</label>
            <input type="text" id="specialty" name="specialty" maxlength="200" value="<%= consultant.specialty || '' %>">
          </div>
        </div>

        <div class="form-row">
          <div>
            <label for="email">Email</label>
            <input type="email" id="email" name="email" maxlength="200" value="<%= consultant.email || '' %>">
          </div>
          <div>
            <label for="phone">Phone</label>
            <input type="text" id="phone" name="phone" maxlength="200" value="<%= consultant.phone || '' %>">
          </div>
        </div>

        <% if (departmentsList) { %>
          <label for="department_id">Department</label>
          <select id="department_id" name="department_id" required>
            <% departmentsList.forEach(function(d) { %>
              <option value="<%= d.id %>" <%= consultant.department_id === d.id ? 'selected' : '' %>><%= d.name %></option>
            <% }) %>
          </select>
        <% } %>

        <label for="status">Status</label>
        <select id="status" name="status" required>
          <% statuses.forEach(function(s) { %>
            <option value="<%= s %>" <%= consultant.status === s ? 'selected' : '' %>><%= s %></option>
          <% }) %>
        </select>

        <div class="form-row">
          <div>
            <label for="engagement_start">Engagement start</label>
            <input type="date" id="engagement_start" name="engagement_start" value="<%= consultant.engagement_start || '' %>">
          </div>
          <div>
            <label for="engagement_end">Engagement end</label>
            <input type="date" id="engagement_end" name="engagement_end" value="<%= consultant.engagement_end || '' %>">
          </div>
        </div>

        <div class="form-row">
          <div>
            <label for="rate">Rate</label>
            <input type="text" id="rate" name="rate" maxlength="200" value="<%= consultant.rate || '' %>">
          </div>
          <div>
            <label for="assigned_to">Assigned to</label>
            <select id="assigned_to" name="assigned_to">
              <option value="">Unassigned</option>
              <% assignableAgents.forEach(function(a) { %>
                <option value="<%= a.id %>" <%= consultant.assigned_to === a.id ? 'selected' : '' %>><%= a.name %></option>
              <% }) %>
            </select>
          </div>
        </div>

        <label for="notes">Notes</label>
        <textarea id="notes" name="notes" rows="4" maxlength="5000"><%= consultant.notes || '' %></textarea>

        <button type="submit" class="button-primary">Save changes</button>
      </form>
    </div>

    <div class="card">
      <h2>Activity</h2>
      <ul class="activity-feed">
        <% if (!activity.length) { %>
          <li class="muted">No activity yet.</li>
        <% } %>
        <% activity.forEach(function(a) { %>
          <li class="activity-item">
            <div class="activity-meta">
              <strong><%= a.agent_name || 'System' %></strong> &middot; <%= a.created_at %>
            </div>
            <div class="activity-body"><%= a.body %></div>
          </li>
        <% }) %>
      </ul>
    </div>
  </div>

  <div class="ticket-side">
    <% if (currentAgent.is_admin || consultant.assigned_to === currentAgent.id) { %>
      <div class="card">
        <h2>Confidential</h2>
        <p class="muted">Hides this record from every same-department agent except its assigned agent and admins.</p>
        <form action="/dashboard/consultants/<%= consultant.id %>/confidential" method="POST" class="property-row">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label class="checkbox-label">
            <input type="checkbox" name="confidential" value="1" <%= consultant.confidential ? 'checked' : '' %> data-autosubmit>
            Confidential
          </label>
        </form>
      </div>
    <% } %>
  </div>
</div>

<p><a href="/dashboard/consultants">&larr; Back to all consultants</a></p>
<%- include('../partials/footer') %>
