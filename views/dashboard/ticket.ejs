<%- include('../partials/header') %>
<% if (mergedFrom) { %>
  <div class="alert alert-info" role="status"><span class="icon icon-alert-triangle"></span>Ticket #<%= mergedFrom %> was merged into this one - its activity and attachments now appear below.</div>
<% } %>
<% if (ticket.data_erased_at) { %>
  <div class="alert alert-info" role="status"><span class="icon icon-alert-triangle"></span>This requester's data was erased on <%= ticket.data_erased_at %> per a GDPR request. Name, email, and free-text content below have been redacted.</div>
<% } %>
<div class="ticket-head">
  <div>
    <h1>#<%= ticket.id %> &middot; <%= ticket.subject %></h1>
    <div class="requester-line">
      <% if (requesterProfile) { %>
        <img class="directory-avatar" src="/dashboard/directory/photo?email=<%= encodeURIComponent(ticket.requester_email) %>" alt="">
      <% } %>
      <p class="muted">
        From <%= ticket.requester_name %> (<%= ticket.requester_email %>) &middot; opened <%= ticket.created_at %>
        <% if (requesterProfile && (requesterProfile.jobTitle || requesterProfile.department || requesterProfile.phone)) { %>
          <br>
          <%= [requesterProfile.jobTitle, requesterProfile.department].filter(Boolean).join(' · ') %><% if (requesterProfile.phone) { %><%= (requesterProfile.jobTitle || requesterProfile.department) ? ' · ' : '' %><%= requesterProfile.phone %><% } %>
        <% } %>
      </p>
    </div>
  </div>
  <div class="badge-group">
    <% if (departmentName) { %><span class="badge"><%= departmentName %></span><% } %>
    <% if (ticket.confidential) { %><span class="badge badge-aging">Confidential</span><% } %>
    <% if (aging) { %><span class="badge badge-aging">Aging</span><% } %>
    <% if (ticket.approval_status === 'pending') { %><span class="badge badge-approval-pending">Pending Approval</span><% } %>
    <% if (ticket.approval_status === 'rejected') { %><span class="badge badge-approval-rejected">Approval Rejected</span><% } %>
    <span class="badge badge-priority-<%= ticket.priority.toLowerCase() %>"><%= ticket.priority %></span>
    <span class="badge badge-status-<%= ticket.status.replace(/\s+/g, '-').toLowerCase() %>"><%= ticket.status %></span>
    <form action="/dashboard/tickets/<%= ticket.id %>/<%= isWatching ? 'unwatch' : 'watch' %>" method="POST" class="inline-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="button-secondary"><%= isWatching ? 'Stop watching' : 'Watch' %></button>
    </form>
  </div>
</div>

<% if (watchers.length) { %>
  <p class="muted">Watched by <%= watchers.map(function(w) { return w.name; }).join(', ') %></p>
<% } %>

<div class="tag-row">
  <% tags.forEach(function(t) { %>
    <span class="tag-chip">
      <%= t.name %>
      <form action="/dashboard/tickets/<%= ticket.id %>/tags/<%= t.id %>/remove" method="POST" class="inline-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" aria-label="Remove tag <%= t.name %>">&times;</button>
      </form>
    </span>
  <% }) %>
  <form action="/dashboard/tickets/<%= ticket.id %>/tags" method="POST" class="tag-add-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="text" name="tag" placeholder="Add a tag&hellip;" maxlength="30" list="existing-tags">
    <datalist id="existing-tags">
      <% allTags.forEach(function(t) { %><option value="<%= t.name %>"><% }) %>
    </datalist>
    <button type="submit" class="button-secondary">Add tag</button>
  </form>
</div>

<div class="ticket-grid">
  <div class="ticket-main">
    <div class="card">
      <h2>Description</h2>
      <p class="preserve-newlines"><%- renderRichText(ticket.description) %></p>
      <p class="muted">Category: <%= ticket.category %><% if (ticket.subcategory) { %> &rsaquo; <%= ticket.subcategory %><% } %></p>
      <% if (customFieldValues.length) { %>
        <dl class="def-list">
          <% customFieldValues.forEach(function(f) { %>
            <dt><%= f.field_name %></dt><dd><%= f.value %></dd>
          <% }) %>
        </dl>
      <% } %>

      <% if (rating) { %>
        <h2>Satisfaction rating</h2>
        <% if (rating.rating <= 2) { %>
          <div class="alert alert-error" role="alert"><span class="icon icon-alert-triangle"></span>Low satisfaction rating - worth a follow-up.</div>
        <% } %>
        <p class="rating-stars" aria-label="<%= rating.rating %> out of 5 stars">
          <% for (let i = 1; i <= 5; i++) { %><span class="icon icon-star <%= i <= rating.rating ? 'is-filled' : '' %>"></span><% } %>
        </p>
        <% if (rating.comment) { %><p class="preserve-newlines"><%= rating.comment %></p><% } %>
      <% } %>

      <% if (attachments.length) { %>
        <h2>Attachments</h2>
        <ul class="attachment-list">
          <% attachments.forEach(function(a) { %>
            <li class="attachment-item">
              <% if (a.is_previewable) { %>
                <img class="attachment-thumb" src="/dashboard/tickets/<%= ticket.id %>/attachments/<%= a.id %>/preview" alt="">
              <% } %>
              <span class="attachment-name"><%= a.original_name %></span>
              <span class="attachment-meta">
                <%= a.uploaded_by === 'agent' ? a.agent_name : ticket.requester_name %> &middot; <%= a.size_label %>
                <% if (!a.visible_to_requester) { %>&middot; internal only<% } %>
              </span>
              <a class="attachment-download-btn" href="/dashboard/tickets/<%= ticket.id %>/attachments/<%= a.id %>/download">
                <span class="icon icon-download"></span>Download
              </a>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </div>

    <div class="card">
      <h2>Activity</h2>
      <ul class="activity-feed">
        <% if (!activity.length) { %>
          <li class="muted">No activity yet.</li>
        <% } %>
        <% activity.forEach(function(a) { %>
          <li class="activity-item activity-<%= a.type %>">
            <div class="activity-meta">
              <strong><%= a.type === 'requester_reply' ? ticket.requester_name : (a.agent_name || 'System') %></strong>
              &middot; <%= a.created_at %>
              <% if (a.type === 'reply' || a.type === 'requester_reply') { %><span class="badge badge-visible-to-requester">Visible to requester</span><% } %>
            </div>
            <div class="activity-body <%= ['note', 'reply', 'requester_reply'].includes(a.type) ? '' : 'muted' %>"><%- renderRichText(a.body) %></div>
          </li>
        <% }) %>
      </ul>

      <form action="/dashboard/tickets/<%= ticket.id %>/note" method="POST" class="stacked-form" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <% if (cannedResponses.length) { %>
          <label for="canned-select">Insert a canned response</label>
          <select id="canned-select" data-target="body">
            <option value="">Choose one&hellip;</option>
            <% cannedResponses.forEach(function(c) { %>
              <option value="<%= c.body.replace(/"/g, '&quot;') %>"><%= c.title %></option>
            <% }) %>
          </select>
        <% } %>

        <% if (kbArticles.length) { %>
          <label for="kb-select">Link a help article</label>
          <select id="kb-select" data-target="body">
            <option value="">Choose one&hellip;</option>
            <% kbArticles.forEach(function(a) { %>
              <option value="<%= a.url %>"><%= a.title %></option>
            <% }) %>
          </select>
        <% } %>

        <label for="body">Add a note</label>
        <textarea id="body" name="body" rows="3" maxlength="5000" placeholder="Internal note, visible to helpdesk staff only"></textarea>
        <p class="field-hint">**bold**, *italic*, and [links](https://example.com) are supported. Mention a colleague with @firstnamelastname (e.g. @janedoe) to email them.</p>

        <label class="checkbox-label">
          <input type="checkbox" name="visibility" value="reply">
          Send as a reply to the requester (visible to them, and emailed if notifications are configured)
        </label>

        <label for="note-attachments">Attach a file</label>
        <input type="file" id="note-attachments" name="attachments" multiple data-dropzone accept=".png,.jpg,.jpeg,.gif,.webp,.pdf,.txt,.csv">
        <p class="field-hint"><%= uploadHint %></p>

        <button type="submit" class="button-primary">Add note</button>
      </form>
    </div>
  </div>

  <div class="ticket-side">
    <div class="card">
      <h2>Properties</h2>
      <div class="property-list">
        <form action="/dashboard/tickets/<%= ticket.id %>/asset" method="POST" class="property-row">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label for="asset_id">Asset</label>
          <select id="asset_id" name="asset_id">
            <option value="">No asset</option>
            <% assignableAssets.forEach(function(a) { %>
              <option value="<%= a.id %>" <%= ticket.asset_id === a.id ? 'selected' : '' %>>
                <% if (a.asset_tag) { %><%= a.asset_tag %><% } else { %>Asset #<%= a.id %><% } %>
              </option>
            <% }) %>
          </select>
          <button type="submit" class="button-secondary">Save</button>
        </form>
        <% if (asset) { %>
          <p class="muted">Linked: <a href="/dashboard/assets/<%= asset.id %>"><%= asset.name %></a></p>
        <% } else { %>
          <p class="muted">No asset linked.</p>
        <% } %>

        <form action="/dashboard/tickets/<%= ticket.id %>/priority" method="POST" class="property-row">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label for="priority">Priority</label>
          <select id="priority" name="priority">
            <% priorities.forEach(function(p) { %>
              <option value="<%= p %>" <%= ticket.priority === p ? 'selected' : '' %>><%= p %></option>
            <% }) %>
          </select>
          <button type="submit" class="button-secondary">Save</button>
        </form>

        <form action="/dashboard/tickets/<%= ticket.id %>/status" method="POST" class="property-row">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="expected_updated_at" value="<%= ticket.updated_at %>">
          <label for="status">Status</label>
          <select id="status" name="status">
            <% statuses.forEach(function(s) { %>
              <option value="<%= s %>" <%= ticket.status === s ? 'selected' : '' %>><%= s %></option>
            <% }) %>
          </select>
          <button type="submit" class="button-secondary">Save</button>
        </form>

        <form action="/dashboard/tickets/<%= ticket.id %>/assign" method="POST" class="property-row">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="expected_updated_at" value="<%= ticket.updated_at %>">
          <label for="assigned_to">Assigned</label>
          <select id="assigned_to" name="assigned_to">
            <option value="">Unassigned</option>
            <% agents.forEach(function(a) { %>
              <option value="<%= a.id %>" <%= ticket.assigned_to === a.id ? 'selected' : '' %>><%= a.name %></option>
            <% }) %>
          </select>
          <button type="submit" class="button-secondary">Save</button>
        </form>

        <form action="/dashboard/tickets/<%= ticket.id %>/confidential" method="POST" class="property-row">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label class="checkbox-label">
            <input type="checkbox" name="confidential" value="1" <%= ticket.confidential ? 'checked' : '' %> data-autosubmit>
            Confidential
          </label>
        </form>
        <p class="field-hint">Hides this ticket from every same-department agent except its assignee and admins. Department scoping still applies underneath this - it never widens who can see the ticket, only narrows it further.</p>

        <form action="/dashboard/tickets/<%= ticket.id %>/reminder" method="POST" class="property-row">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label for="reminder_date">Reminder date</label>
          <input type="date" id="reminder_date" name="reminder_date" value="<%= ticket.reminder_date || '' %>">
          <button type="submit" class="button-secondary">Save</button>
        </form>
        <p class="field-hint">Emails this ticket's department as the date approaches (most relevant for a contract/compliance deadline), and re-alerts if the date changes. Leave blank to disable.</p>
      </div>
    </div>

    <% if (currentAgent && currentAgent.is_admin) { %>
      <div class="card">
        <h2>Transfer to another department</h2>
        <p class="muted">Moves this ticket by changing its category - department is always derived from category, so this is what actually moves it. It leaves the sending department's queue and enters the target department's immediately.</p>
        <form
          action="/dashboard/tickets/<%= ticket.id %>/transfer"
          method="POST"
          class="property-row"
          data-confirm="Transfer ticket #<%= ticket.id %> to this category? It will leave the current department's queue immediately and this can't be undone from here."
        >
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label for="transfer_category">New category</label>
          <select id="transfer_category" name="category">
            <% Object.keys(categoriesByDepartment).forEach(function(deptName) { %>
              <optgroup label="<%= deptName %>">
                <% categoriesByDepartment[deptName].forEach(function(c) { %>
                  <option value="<%= c.name %>" <%= ticket.category === c.name ? 'selected' : '' %>><%= c.name %></option>
                <% }) %>
              </optgroup>
            <% }) %>
          </select>
          <button type="submit" class="button-secondary">Transfer</button>
        </form>
      </div>
    <% } %>

    <% if (requiresApproval || ticket.approval_status) { %>
      <div class="card">
        <h2>Approval</h2>
        <% if (ticket.approval_status === 'pending') { %>
          <p class="muted">Awaiting approval before this ticket can close.</p>
          <% if (currentAgent.is_admin) { %>
            <form action="/dashboard/tickets/<%= ticket.id %>/approval/approve" method="POST" class="inline-form">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="button-primary">Approve &amp; close</button>
            </form>
            <form action="/dashboard/tickets/<%= ticket.id %>/approval/reject" method="POST" class="stacked-form">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <label for="approval-note">Reviewer note (optional, shown to the assignee)</label>
              <textarea id="approval-note" name="note" rows="2" maxlength="1000" placeholder="What needs to change before this can close?"></textarea>
              <button type="submit" class="button-secondary">Reject</button>
            </form>
          <% } else { %>
            <p class="muted">Only an admin can approve or reject.</p>
          <% } %>
        <% } else if (ticket.approval_status === 'rejected') { %>
          <div class="alert alert-error" role="alert">
            <span class="icon icon-alert-triangle"></span>Rejected - not ready to close<% if (ticket.approval_note) { %>: <%= ticket.approval_note %><% } %>. Select "Closed" again once it's addressed to resubmit for approval.
          </div>
        <% } else if (ticket.approval_status === 'approved') { %>
          <p class="muted">Approved and closed.</p>
        <% } else { %>
          <p class="muted">Closing a ticket in this category requires an admin's approval - selecting "Closed" below will submit it instead of closing it directly.</p>
        <% } %>
      </div>
    <% } %>

    <div class="card" id="time">
      <h2>Time tracked</h2>
      <p class="muted">Total: <strong><%= formatMinutes(totalTimeMinutes) %></strong></p>

      <% if (timeEntries.length) { %>
        <ul class="requester-history">
          <% timeEntries.forEach(function(e) { %>
            <li>
              <span><%= formatMinutes(e.minutes) %> &middot; <%= e.agent_name || 'Unknown agent' %> &middot; <%= e.logged_on %></span>
              <% if (e.note) { %><span class="muted"> &mdash; <%= e.note %></span><% } %>
              <form action="/dashboard/tickets/<%= ticket.id %>/time/<%= e.id %>/delete" method="POST" class="inline-form">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="link-button">Remove</button>
              </form>
            </li>
          <% }) %>
        </ul>
      <% } else { %>
        <p class="muted">No time logged yet.</p>
      <% } %>

      <form action="/dashboard/tickets/<%= ticket.id %>/time" method="POST" class="stacked-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-row">
          <div>
            <label for="time-minutes">Minutes spent</label>
            <input type="number" id="time-minutes" name="minutes" min="1" max="1440" required placeholder="e.g. 45">
          </div>
          <div>
            <label for="time-logged-on">Date</label>
            <input type="date" id="time-logged-on" name="logged_on" value="<%= todayDate %>">
          </div>
        </div>
        <label for="time-note">Note (optional)</label>
        <input type="text" id="time-note" name="note" maxlength="500" placeholder="What did you work on?">
        <button type="submit" class="button-secondary">Log time</button>
      </form>
    </div>

    <div class="card">
      <h2>Relationships</h2>

      <% if (possibleDuplicates.length) { %>
        <p class="card-subhead">Possible duplicates</p>
        <ul class="requester-history">
          <% possibleDuplicates.forEach(function(d) { %>
            <li>
              <a href="/dashboard/tickets/<%= d.id %>">#<%= d.id %> &middot; <%= d.subject %></a>
              <form action="/dashboard/tickets/<%= ticket.id %>/merge" method="POST" class="inline-form" data-confirm="Merge this ticket into #<%= d.id %>? Its activity, attachments, and tags will move over, and this ticket will close.">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="target_ticket_id" value="<%= d.id %>">
                <button type="submit" class="link-button">Merge into this</button>
              </form>
            </li>
          <% }) %>
        </ul>
      <% } %>

      <p class="card-subhead">Related tickets</p>
      <% if (linkedTickets.length) { %>
        <ul class="requester-history">
          <% linkedTickets.forEach(function(l) { %>
            <li>
              <a href="/dashboard/tickets/<%= l.id %>">#<%= l.id %> &middot; <%= l.subject %></a>
              <span class="badge badge-status-<%= l.status.replace(/\s+/g, '-').toLowerCase() %>"><%= l.status %></span>
              <form action="/dashboard/tickets/<%= ticket.id %>/link/<%= l.id %>/remove" method="POST" class="inline-form">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="link-button">Unlink</button>
              </form>
            </li>
          <% }) %>
        </ul>
      <% } %>
      <form action="/dashboard/tickets/<%= ticket.id %>/link" method="POST" class="property-row">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label for="linked_ticket_id">Link #</label>
        <input type="number" id="linked_ticket_id" name="linked_ticket_id" min="1" required>
        <button type="submit" class="button-secondary">Link</button>
      </form>

      <p class="card-subhead">Merge into another ticket</p>
      <form
        action="/dashboard/tickets/<%= ticket.id %>/merge"
        method="POST"
        class="property-row"
        data-confirm="Merge ticket #<%= ticket.id %> into another ticket? Its activity, attachments, and tags will move over, and this ticket will close. This can't be undone from here."
      >
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label for="target_ticket_id">Merge into #</label>
        <input type="number" id="target_ticket_id" name="target_ticket_id" min="1" required>
        <button type="submit" class="button-secondary">Merge</button>
      </form>
    </div>

    <% if (currentAgent.is_admin) { %>
    <div class="card">
      <h2>Requester data</h2>
      <% if (ticket.data_erased_at) { %>
        <p class="muted">Erased on <%= ticket.data_erased_at %>.</p>
      <% } else { %>
        <p class="muted">GDPR export/erasure for <%= ticket.requester_email %>, across all of their tickets. Admin-only, since it reaches every department they've filed a ticket in, not just this one.</p>
        <a class="button-secondary" href="/dashboard/tickets/<%= ticket.id %>/privacy/export.json">
          <span class="icon icon-download"></span>Export data
        </a>
        <form
          action="/dashboard/tickets/<%= ticket.id %>/privacy/erase"
          method="POST"
          data-confirm="Permanently erase <%= ticket.requester_email %>'s name, email, and free-text content across ALL of their tickets? This can't be undone."
        >
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="button-secondary">Erase data</button>
        </form>
      <% } %>
    </div>
    <% } %>

    <% if (otherTickets.length) { %>
      <div class="card">
        <h2>From this requester</h2>
        <p class="muted"><%= otherTickets.length %> other ticket<%= otherTickets.length === 1 ? '' : 's' %> from <%= ticket.requester_name %></p>
        <ul class="requester-history">
          <% otherTickets.forEach(function(t) { %>
            <li>
              <a href="/dashboard/tickets/<%= t.id %>">#<%= t.id %> &middot; <%= t.subject %></a>
              <span class="badge badge-status-<%= t.status.replace(/\s+/g, '-').toLowerCase() %>"><%= t.status %></span>
            </li>
          <% }) %>
        </ul>
      </div>
    <% } %>
  </div>
</div>

<p>
  <a href="/dashboard">&larr; Back to all tickets</a>
  &middot; <a href="/dashboard/tickets/<%= ticket.id %>/print" target="_blank" rel="noopener">Print / Save as PDF</a>
  <% if (currentAgent.is_admin) { %>
    &middot; <a href="/dashboard/tickets/<%= ticket.id %>/view-as-requester" target="_blank" rel="noopener">View as requester (preview)</a>
  <% } %>
</p>
<%- include('../partials/footer') %>
