<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'en' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light dark">
  <title><%= title %> · Velv Ticketing</title>
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/theme-init.js"></script>
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to main content</a>
  <header class="site-header">
    <div class="site-header-inner">
      <a class="brand" href="<%= typeof currentAgent !== 'undefined' && currentAgent ? '/dashboard' : '/' %>">
        <img class="brand-logo brand-logo-light" src="/img/velv-logo-purple.png" alt="Velv">
        <img class="brand-logo brand-logo-dark" src="/img/velv-logo-white.png" alt="Velv">
        <span class="brand-suffix">Ticketing</span>
      </a>
      <button type="button" class="nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="nav-cluster" aria-label="Menu">
        <span class="icon icon-menu nav-toggle-icon-open"></span>
        <span class="icon icon-x nav-toggle-icon-close"></span>
      </button>
      <div class="nav-cluster" id="nav-cluster">
        <nav class="main-nav">
          <% if (typeof currentAgent !== 'undefined' && currentAgent) { %>
            <a href="/dashboard">Dashboard</a>
            <a href="/dashboard/assets">Assets</a>
            <a href="/dashboard/consultants">Consultants</a>
            <details class="nav-more">
              <summary>More <span class="nav-more-caret" aria-hidden="true">&#9662;</span></summary>
              <div class="nav-more-dropdown">
                <% if (currentAgent.is_admin) { %>
                  <a href="/dashboard/agents">Agents</a>
                <% } %>
                <a href="/dashboard/canned-responses">Canned responses</a>
                <a href="/dashboard/kb">Knowledge base</a>
                <a href="/dashboard/settings">Settings</a>
              </div>
            </details>
            <details class="notif-bell" data-csrf="<%= csrfToken %>">
              <summary aria-label="Notifications">
                <span class="icon icon-bell"></span>
                <% if (typeof notifUnreadCount !== 'undefined' && notifUnreadCount > 0) { %>
                  <span class="notif-badge"><%= notifUnreadCount > 99 ? '99+' : notifUnreadCount %></span>
                <% } %>
              </summary>
              <div class="notif-dropdown">
                <% if (typeof notifRecent === 'undefined' || !notifRecent.length) { %>
                  <p class="notif-empty">No notifications yet.</p>
                <% } else { %>
                  <% notifRecent.forEach(function(n) { %>
                    <a class="notif-item <%= n.read_at ? '' : 'is-unread' %>" href="<%= n.ticket_id ? '/dashboard/tickets/' + n.ticket_id : '/dashboard' %>">
                      <%= n.message %>
                      <span class="notif-time"><%= n.created_at %></span>
                    </a>
                  <% }) %>
                <% } %>
              </div>
            </details>
            <span class="nav-user">
              <img class="directory-avatar directory-avatar-sm" src="/dashboard/directory/photo?email=<%= encodeURIComponent(currentAgent.email) %>" alt="">
              Signed in as <%= currentAgent.name %><% if (currentAgent.is_admin) { %> &middot; <strong>Admin</strong><% } else if (currentAgent.department_name) { %> &middot; <%= currentAgent.department_name %><% } %>
            </span>
            <form action="/logout" method="POST" class="inline-form">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="link-button">Log out</button>
            </form>
          <% } else { %>
            <a href="/"><%= t('nav_submit_request') %></a>
            <a href="/status"><%= t('nav_check_status') %></a>
            <a href="/login" class="nav-cta"><%= t('nav_helpdesk_login') %></a>
          <% } %>
        </nav>
        <% if (typeof currentAgent === 'undefined' || !currentAgent) { %>
          <div class="lang-toggle">
            <a href="/lang/en" class="<%= lang === 'en' ? 'is-active' : '' %>">EN</a>
            <a href="/lang/pt" class="<%= lang === 'pt' ? 'is-active' : '' %>">PT</a>
          </div>
        <% } %>
        <label class="lights-toggle">
          <input type="checkbox" id="lights-switch" checked>
          <span class="lights-track">
            <span class="icon icon-sun"></span>
            <span class="icon icon-moon"></span>
            <span class="lights-thumb"></span>
          </span>
          <span class="lights-label">Lights</span>
        </label>
      </div>
    </div>
  </header>
  <main class="page<%= typeof wide !== 'undefined' && wide ? ' page-wide' : '' %>" id="main-content">
